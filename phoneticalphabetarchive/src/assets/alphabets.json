[
  {
    "id": "parkoszowic",
    "title": "Parkoszowic's Treatise",
    "year": 1440,
    "information": {
      "number": 44,
      "language": "Polish",
      "author": "Jakub Parkoszowic (?-1452) was a linguist and a professor at the Jagiellonian University.",
      "publication": "Jakub published his proposal Traktat o ortografii polskiej for a Polish orthography reform in 1440. During that time Poland was in the midst of the Jagiellonian Era. This period is often seen as one of political power and stability, marked by great prosperity, and in its later stages, a Golden Age of Polish culture.",
      "motivation": "He sought to standardize the Polish written language and developed new characters to represent specific Polish sounds that could not be conveyed using Latin letters.",
      "system": "Jakub introduced the use of double vowels to indicate vowel length and coined the terms dürum and molde, meaning “hard” and “soft” respectively. The dürum letters featured more angular shapes to visually convey the hardness of their sounds. In addition, he devised new characters to represent Polish phonemes that could not be captured by existing Latin letters, ultimately creating a system with 44 distinct graphemes.",
      "longevity": "Despite his efforts, his proposal ultimately failed to gain the necessary support, and over time, interest in his work waned. The manuscript, once considered a potential breakthrough, was subsequently neglected and eventually lost to history. It remained forgotten for decades, only to be rediscovered in 1830."
    }
  },
  {
    "id": "ortgrafijapolska",
    "title": "Ortgrafija Polska",
    "year": 1551,
    "number": 51,
    "language": "Polish",
    "information": {
      "author": "Stanisław Murzynowski (1527-1553) was a Polish writer, translator, and Lutheran activist during the Protestant Reformation. He is known for being the author of the first complete translation of the New Testament into Polish, though he was not given credit, possibly due to his young age.",
      "publication": "When he published his proposal Ortografija Polska in 1551, it was in response to previous reforms, and Poland was in the later stages of the Jagiellonian Era, or the Golden Age of Polish culture.",
      "motivation": "He wanted to standardize Polish orthography as the Latin alphabet did not support the Polish sounds.",
      "system": "He employed diacritical marks to represent long vowels and palatalized consonants, aiming to capture the nuances of spoken language more accurately. Through this meticulous approach, he eventually devised an entirely new writing system composed of 51 distinct characters. This comprehensive alphabet was a significant departure from previous scripts and reflected his deep commitment to linguistic precision and reform.",
      "longevity": "As linguistic trends evolved and new scholarly and political influences emerged, many aspects of his system—along with those of other contemporary orthographic standards—were gradually abandoned or replaced. Over time, these earlier efforts gave way to more modern approaches to Polish spelling and grammar, reflecting the dynamic nature of the language and its ongoing development."
    }
  },
